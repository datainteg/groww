            ST1["auth.store.ts"]
            ST2["market.store.ts"]
            ST3["strategy.store.ts"]
            ST4["trade.store.ts"]
            ST5["ui.store.ts"]
        end
    end

    subgraph BACKEND["⚙️ BACKEND (Flask)"]
        subgraph AUTH_ROUTES["auth_routes.py"]
            AR1["POST /api/auth/register"]
            AR2["POST /api/auth/login"]
            AR3["GET /api/auth/me"]
            AR4["GET /api/auth/profile"]
            AR5["POST /api/auth/update-groww-credentials"]
            AR6["POST /api/auth/refresh-token"]
        end
        
        subgraph MARKET_ROUTES["market_routes.py"]
            MR1["GET /api/market/status"]
            MR2["GET /api/market/indices"]
            MR3["GET /api/market/ltp/:symbol"]
            MR4["GET /api/market/quote/:symbol"]
            MR5["GET /api/market/option-chain/:underlying"]
        end
        
        subgraph INSTRUMENT_ROUTES["instruments_routes.py"]
            IR1["POST /api/instruments/sync"]
            IR2["GET /api/instruments/list"]
            IR3["GET /api/instruments/search"]
            IR4["GET /api/instruments/expiries/:underlying"]
            IR5["GET /api/instruments/atm/:underlying/:expiry"]
            IR6["GET /api/instruments/greeks/:symbol"]
        end
        
        subgraph STRATEGY_ROUTES["strategy_routes.py"]
            SR1["POST /api/strategy/create"]
            SR2["GET /api/strategy/list"]
            SR3["GET /api/strategy/:id"]
            SR4["PUT /api/strategy/:id"]
            SR5["DELETE /api/strategy/:id"]
