        subgraph SETTINGS_ROUTES["settings_routes.py"]
            STR1["GET /api/settings/"]
            STR2["PUT /api/settings/"]
            STR3["POST /api/settings/telegram"]
            STR4["POST /api/settings/kill-switch"]
        end
    end

    subgraph GROWW["🌐 GROWW API"]
