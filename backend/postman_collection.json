            "method": "POST",
            "url": "{{base_url}}/strategy/{{strategy_id}}/stop",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Manual stop\"\n}"
            },
            "description": "Stop a running strategy."
