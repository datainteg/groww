    {
      "name": "Strategy",
      "description": "Strategy management and AI-powered decision engine",
      "item": [
        {
          "name": "Create Strategy",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.strategy_id) {",
                  "    pm.collectionVariables.set('strategy_id', jsonData.strategy_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/strategy/create",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"NIFTY Scalper\",\n  \"index\": \"NIFTY\",\n  \"ce_symbol\": \"NIFTY25JAN23000CE\",\n  \"pe_symbol\": \"NIFTY25JAN23000PE\",\n  \"quantity\": 50,\n  \"stop_loss\": 50,\n  \"target\": 100,\n  \"trailing_sl_enabled\": true,\n  \"trailing_sl_value\": 20,\n  \"break_even_enabled\": true,\n  \"break_even_trigger\": 50,\n  \"partial_exit_enabled\": false,\n  \"partial_exit_percent\": 50,\n  \"time_exit_enabled\": true,\n  \"max_orders_per_day\": 2,\n  \"max_profit_limit\": 5000,\n  \"max_loss_limit\": 2000\n}"
            },
            "description": "Create a new trading strategy with risk management settings."
          }
        },
        {
          "name": "List Strategies",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/strategy/list",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "List all strategies for the current user."
          }
        },
        {
          "name": "Get Strategy",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/strategy/{{strategy_id}}",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "Get details of a specific strategy."
          }
        },
        {
          "name": "Update Strategy",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/strategy/{{strategy_id}}",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stop_loss\": 60,\n  \"target\": 120,\n  \"trailing_sl_enabled\": true\n}"
            },
            "description": "Update strategy settings. Cannot update active strategies."
          }
        },
        {
          "name": "Delete Strategy",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/strategy/{{strategy_id}}",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "Delete a strategy. Cannot delete active strategies."
          }
