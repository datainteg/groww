        {
          "name": "Start Strategy",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/strategy/{{strategy_id}}/start",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "Start/activate a strategy for trading."
          }
        },
        {
          "name": "Stop Strategy",
