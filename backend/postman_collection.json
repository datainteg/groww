            "description": "Get AI-powered trading decision using 67 technical indicators. Returns BULLISH/BEARISH signal with confidence score."
          }
        },
        {
          "name": "Get All Indicators",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/strategy/indicators/NIFTY?interval=5",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
