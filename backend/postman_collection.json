          "name": "Update Theme",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/settings/theme",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"theme\": \"dark\"\n}"
            },
            "description": "Update UI theme (dark or light)."
          }
        },
        {
          "name": "Toggle Kill Switch",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/settings/kill-switch",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true\n}"
            },
            "description": "Enable/disable kill switch. When enabled, stops all strategies immediately."
          }
        },
        {
          "name": "Configure Telegram",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/settings/telegram",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bot_token\": \"your_telegram_bot_token\",\n  \"chat_id\": \"your_chat_id\"\n}"
            },
            "description": "Configure Telegram notifications. Get bot_token from @BotFather and chat_id from @userinfobot."
          }
        },
        {
          "name": "Test Telegram",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/settings/telegram/test",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "Send a test message to verify Telegram configuration."
          }
        },
        {
          "name": "Disconnect Telegram",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/settings/telegram",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "Disconnect Telegram notifications."
          }
        },
        {
          "name": "Reset Daily Counters",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/settings/reset-daily",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "Reset daily P&L and order counters for all strategies. Usually done at start of trading day."
          }
        }
      ]
    }
  ]
}
