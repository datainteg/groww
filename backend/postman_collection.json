{
  "info": {
    "name": "AI Trading System API - Complete",
    "description": "Complete API collection for AI Trading System with Groww integration.\n\n**Setup Instructions:**\n1. Import this collection into Postman\n2. Set the `base_url` variable to your server URL (default: http://localhost:5000/api)\n3. First call Register or Login to get an access_token\n4. The access_token will be automatically saved to the collection variable\n\n**Authentication:**\nAll endpoints except /health and /auth/register and /auth/login require a Bearer token in the Authorization header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:5000/api", "type": "string"},
    {"key": "access_token", "value": "", "type": "string"},
    {"key": "strategy_id", "value": "", "type": "string"},
    {"key": "trade_id", "value": "", "type": "string"},
    {"key": "order_id", "value": "", "type": "string"}
  ],
  "item": [
    {
      "name": "Health",
      "description": "System health check - No authentication required",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has status', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "description": "Check if the API server is running. No authentication required."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Authentication endpoints for user registration, login, and profile management",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response has access_token', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access_token).to.be.a('string');",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"groww_api_key\": \"\",\n  \"groww_api_secret\": \"\"\n}"
            },
            "description": "Register a new user. Groww API credentials are optional - you can add them later."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has access_token', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access_token).to.be.a('string');",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Login with email and password. Returns JWT access token."
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "Get current logged-in user information."
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/profile",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "Get detailed user profile including masked API key."
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/auth/profile",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newemail@example.com\"\n}"
            },
            "description": "Update user profile. Can update email or password."
          }
        },
        {
          "name": "Update Groww Credentials",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/update-groww-credentials",
            "header": [
              {"key": "Authorization", "value": "Bearer {{access_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groww_api_key\": \"your_groww_api_key\",\n  \"groww_api_secret\": \"your_groww_api_secret\"\n}"
            },
            "description": "Update Groww API credentials for live trading."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/refresh-token",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "Refresh JWT token to extend session."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "description": "Logout user and invalidate session."
          }
        }
      ]
    },
