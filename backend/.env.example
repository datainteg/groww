# Copy to .env and fill with REAL values. Never commit the filled .env.
# Generate strong secrets, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Flask
SECRET_KEY=CHANGE_ME_strong_random
DEBUG=true

# JWT
JWT_SECRET_KEY=CHANGE_ME_strong_random
JWT_ACCESS_TOKEN_EXPIRES=86400

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=ai_trading_system

# Redis (use rediss:// + password + TLS in production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Encryption (protects stored broker credentials) — MUST be strong & unique
ENCRYPTION_KEY=CHANGE_ME_32+_byte_random

# Groww API
GROWW_API_BASE_URL=https://api.groww.in

# Execution mode: PAPER or LIVE (LIVE places real-money orders)
EXECUTION_MODE=PAPER
SLIPPAGE_PERCENT=0.0005
PAPER_INITIAL_CAPITAL=1000000

# Auto-exit (force-close positions before market close, IST)
AUTO_EXIT_HOUR=15
AUTO_EXIT_MINUTE=15

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
